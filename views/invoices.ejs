<%- include('partials/head', { title: 'Invoices' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 mb-0 fw-bold">Invoices</h1>
      </div>
      <%- include('partials/pager', { page, pages, total, baseUrl: '/admin/invoices' }) %>
      
      <div class="card overflow-hidden my-3">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Customer</th><th>Period</th><th>Amount</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
              <% invoices.forEach((i) => { %>
              <tr>
                <td class="fw-semibold"><%= i.customer %></td>
                <td class="font-monospace small text-body-secondary"><%= i.period_start %> → <%= i.period_end %></td>
                <td class="font-monospace fw-semibold"><%= money(i.amount) %></td>
                <td><%= i.status === 'paid' ? '<span class="badge text-bg-success bg-gradient">Paid</span>' : '<span class="badge text-bg-warning bg-gradient">Open</span>' %></td>
                <td class="text-end"><% if (i.status === 'open') { %><button class="btn btn-sm btn-outline-secondary" data-pay="<%= i.id %>">Mark Paid</button><% } %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="mt-3"><%- include('partials/pager', { page, pages, total, baseUrl: '/admin/invoices' }) %></div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    $('[data-pay]').on('click', async function () {
      try { await api(`/api/invoices/${this.dataset.pay}/pay`, { method: 'POST' }); location.reload(); }
      catch (err) { showErr('.admin-main', err.message); }
    });
  </script>
</body>
</html>
