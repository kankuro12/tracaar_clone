<%- include('partials/head', { title: 'Alerts' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <h1 class="h4 mb-4">Alerts</h1>
      <%- include('partials/pager', { page, pages, total, baseUrl: '/admin/alerts' }) %>
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Time</th><th>Type</th><th>Message</th><th>Resolved</th></tr></thead>
            <tbody>
              <% if (!alerts.length) { %><tr><td colspan="4" class="text-body-secondary">No alerts yet.</td></tr><% } %>
              <% alerts.forEach((a) => { %>
              <tr>
                <td class="font-monospace small"><%= fmtDT(a.created_at) %></td>
                <td><span class="badge <%= a.type === 'enter' || a.type === 'online' ? 'text-bg-success' : 'text-bg-danger' %>"><%= a.type %></span></td>
                <td><%= a.message %></td>
                <td class="font-monospace small"><%= fmtDT(a.resolved_at) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="mt-3"><%- include('partials/pager', { page, pages, total, baseUrl: '/admin/alerts' }) %></div>
    </main>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
