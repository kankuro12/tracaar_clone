<%- include('partials/head', { title: 'Invoice ' + (invoice.invoice_no || invoice.id) }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-3 p-md-4">
      <a class="btn btn-sm btn-outline-secondary mb-3" href="/admin/<%= user.role === 'super_admin' ? 'invoices' : 'billing' %>">← Back</a>

      <div class="card p-4 mb-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
          <div>
            <div class="label text-uppercase text-body-secondary small fw-semibold">Invoice</div>
            <h1 class="h4 fw-bold font-monospace mb-1"><%= invoice.invoice_no || ('#' + invoice.id) %></h1>
            <div class="text-body-secondary"><%= invoice.customer %></div>
            <% if (invoice.billing_email) { %><div class="text-body-secondary small font-monospace"><%= invoice.billing_email %></div><% } %>
          </div>
          <div class="text-end">
            <% const badge = { paid: 'text-bg-success', overdue: 'text-bg-danger', partial: 'text-bg-info', void: 'text-bg-secondary' }[invoice.status] || 'text-bg-warning'; %>
            <span class="badge <%= badge %> mb-2"><%= invoice.status %></span>
            <div class="small text-body-secondary">Period</div>
            <div class="font-monospace small"><%= String(invoice.period_start).slice(0,10) %> → <%= String(invoice.period_end).slice(0,10) %></div>
            <div class="small text-body-secondary mt-2">Due</div>
            <div class="font-monospace small"><%= invoice.due_date ? String(invoice.due_date).slice(0,10) : '—' %></div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Description</th><th class="text-end">Qty</th><th class="text-end">Unit</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
              <% if (!lines.length) { %><tr><td colspan="4" class="text-body-secondary">No line items recorded.</td></tr><% } %>
              <% lines.forEach((l) => { %>
              <tr>
                <td><%= l.description %></td>
                <td class="text-end font-monospace"><%= Number(l.quantity) %></td>
                <td class="text-end font-monospace"><%= money(l.unit_price) %></td>
                <td class="text-end font-monospace <%= Number(l.amount) < 0 ? 'text-success' : '' %>"><%= money(l.amount) %></td>
              </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr><td colspan="3" class="text-end text-body-secondary">Subtotal</td><td class="text-end font-monospace"><%= money(invoice.subtotal || invoice.amount) %></td></tr>
              <% if (Number(invoice.tax_rate) > 0) { %>
              <tr><td colspan="3" class="text-end text-body-secondary">Tax (<%= Number(invoice.tax_rate) %>%)</td><td class="text-end font-monospace"><%= money(invoice.tax_amount) %></td></tr>
              <% } %>
              <tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td class="text-end font-monospace"><%= money(invoice.amount) %></td></tr>
              <tr><td colspan="3" class="text-end text-body-secondary">Paid</td><td class="text-end font-monospace text-success"><%= money(paid) %></td></tr>
              <tr class="fw-bold"><td colspan="3" class="text-end">Balance</td><td class="text-end font-monospace <%= balance > 0 ? 'text-danger' : '' %>"><%= money(balance) %></td></tr>
            </tfoot>
          </table>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="card-header fw-semibold">Payments</div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Date</th><th>Method</th><th>Reference</th><th>Recorded by</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
              <% if (!payments.length) { %><tr><td colspan="5"><div class="empty-state">No payments recorded yet.</div></td></tr><% } %>
              <% payments.forEach((p) => { %>
              <tr>
                <td class="font-monospace small"><%= fmtDT(p.paid_at) %></td>
                <td><span class="badge text-bg-secondary"><%= p.method %></span></td>
                <td class="font-monospace small text-body-secondary"><%= p.reference || '—' %></td>
                <td class="small text-body-secondary"><%= p.by_name || '—' %></td>
                <td class="text-end font-monospace"><%= money(p.amount) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
