<%- include('partials/head', { title: 'Plans' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <h1 class="h4 mb-4">Plans</h1>
      <div class="card mb-4" style="max-width: 520px">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-body-secondary">New plan</h2>
          <form id="create-plan" class="row g-3">
            <div class="col-12"><label class="form-label">Name</label><input class="form-control" name="name" required></div>
            <div class="col-6"><label class="form-label">Price / month</label><input class="form-control" name="priceMonthly" type="number" step="0.01" min="0" required></div>
            <div class="col-6"><label class="form-label">Max vehicles</label><input class="form-control" name="maxVehicles" type="number" placeholder="-1 = unlimited"></div>
            <div class="col-12"><button class="btn btn-dark" type="submit">Create plan</button></div>
          </form>
        </div>
      </div>
      <div class="card" style="max-width: 520px">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light"><tr><th>Name</th><th>Price</th><th>Max vehicles</th></tr></thead>
          <tbody>
            <% plans.forEach((p) => { %>
            <tr><td class="fw-medium"><%= p.name %></td><td><%= money(p.price_monthly) %></td><td><%= p.max_vehicles < 0 ? 'unlimited' : p.max_vehicles %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    $('#create-plan').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try {
        await api('/api/plans', { method: 'POST', body: JSON.stringify({ name: f.get('name'), priceMonthly: +f.get('priceMonthly'), maxVehicles: f.get('maxVehicles') ? +f.get('maxVehicles') : -1 }) });
        location.reload();
      } catch (err) { showErr(e.target, err.message); }
    });
  </script>
</body>
</html>
