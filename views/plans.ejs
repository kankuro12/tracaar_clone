<%- include('partials/head', { title: 'Plans' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 mb-0 fw-bold">Subscription Plans</h1>
        <span class="badge text-bg-dark border border-secondary-subtle px-3 py-2 font-monospace"><%= plans.length %> Active</span>
      </div>

      <div class="card mb-4" style="max-width: 560px">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">New Plan</h2>
          <form id="create-plan" class="row g-3">
            <div class="col-12">
              <label class="form-label text-body-secondary small font-medium">Name</label>
              <input class="form-control" name="name" required placeholder="Pro Plan">
            </div>
            <div class="col-6">
              <label class="form-label text-body-secondary small font-medium">Price / Month ($)</label>
              <input class="form-control font-monospace" name="priceMonthly" type="number" step="0.01" min="0" required placeholder="49.99">
            </div>
            <div class="col-6">
              <label class="form-label text-body-secondary small font-medium">Max Vehicles</label>
              <input class="form-control font-monospace" name="maxVehicles" type="number" placeholder="-1 = unlimited">
            </div>
            <div class="col-12 mt-3">
              <button class="btn btn-primary bg-gradient d-inline-flex align-items-center gap-2 px-4 py-2 font-medium" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Create Plan
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="card overflow-hidden" style="max-width: 560px">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr><th>Name</th><th>Price</th><th>Max Vehicles</th></tr>
            </thead>
            <tbody>
              <% plans.forEach((p) => { %>
              <tr>
                <td class="fw-semibold"><%= p.name %></td>
                <td class="font-monospace text-emerald"><%= money(p.price_monthly) %></td>
                <td><span class="badge text-bg-dark border border-secondary-subtle font-monospace"><%= p.max_vehicles < 0 ? 'unlimited' : p.max_vehicles %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    $('#create-plan').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try {
        await api('/api/plans', { method: 'POST', body: JSON.stringify({ name: f.get('name'), priceMonthly: +f.get('priceMonthly'), maxVehicles: f.get('maxVehicles') ? +f.get('maxVehicles') : -1 }) });
        location.reload();
      } catch (err) { showErr(e.target, err.message); }
    });
  </script>
</body>
</html>
