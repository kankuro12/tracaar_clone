<%- include('partials/head', { title: 'ERP integration' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 mb-0 fw-bold">ERP Integration Keys</h1>
      </div>

      <div class="card mb-4">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.05em;">How It Works</h2>
          <p class="small text-body-secondary mb-0">Create an API key for external ERP systems. The ERP calls
          <span class="font-monospace text-warning">POST /api/integration/register</span> with
          <span class="font-monospace text-warning">{ erpClientId, email, password }</span> to obtain or rotate its key, then
          <span class="font-monospace text-warning">POST /api/integration/session</span> with
          <span class="font-monospace text-warning">{ erpClientId, apiKey, vehicleIds, sessionLengthSeconds }</span>
          and connects to the returned <span class="font-monospace text-warning">wsUrl</span> for streaming live positions.</p>
        </div>
      </div>

      <div class="card mb-4" style="max-width: 600px">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">New API Key</h2>
          <form id="create-key" class="row g-3">
            <div class="col-12">
              <label class="form-label text-body-secondary small font-medium">Name</label>
              <input class="form-control" name="name" required placeholder='e.g. "Odoo ERP"'>
            </div>
            <div class="col-12">
              <label class="form-label text-body-secondary small font-medium">ERP Client ID</label>
              <input class="form-control font-monospace" name="clientId" placeholder='required — e.g. "odoo-prod"' required>
            </div>
            <div class="col-12 mt-3">
              <button class="btn btn-primary bg-gradient d-inline-flex align-items-center gap-2 px-4 py-2 font-medium" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Create Key
              </button>
            </div>
          </form>
          <div id="key-result" class="mt-3"></div>
        </div>
      </div>

      <div class="card mb-4 overflow-hidden">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Client ID</th><th>Created</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
              <% if (!keys.length) { %><tr><td colspan="5" class="text-body-secondary py-4 text-center">No integration keys generated yet.</td></tr><% } %>
              <% keys.forEach((k) => { %>
              <tr>
                <td class="fw-semibold"><%= k.name %></td>
                <td class="font-monospace small text-body-secondary"><%= k.client_id || '—' %></td>
                <td class="font-monospace small text-body-secondary"><%= fmtDT(k.created_at) %></td>
                <td><%= k.revoked_at ? '<span class="badge text-bg-secondary font-monospace">revoked</span>' : '<span class="badge text-bg-success font-monospace">active</span>' %></td>
                <td class="text-end"><% if (!k.revoked_at) { %><button class="btn btn-sm btn-outline-danger" data-revoke="<%= k.id %>">Revoke</button><% } %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">Test Session Token</h2>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label text-body-secondary small font-medium">Vehicle IDs (comma-separated)</label>
              <input id="test-vids" class="form-control font-monospace" value="<%= vehicles.map((v) => v.id).join(',') %>">
            </div>
            <div class="col-md-3">
              <label class="form-label text-body-secondary small font-medium">TTL Seconds</label>
              <input id="test-ttl" class="form-control font-monospace" type="number" value="300" min="30">
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <button class="btn btn-primary bg-gradient w-100 py-2 font-medium" id="test-session">Mint Session Token</button>
            </div>
          </div>
          <div id="session-result" class="mt-3"></div>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    $('#create-key').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try {
        const r = await api('/api/integration/keys', { method: 'POST', body: JSON.stringify({ name: f.get('name'), clientId: f.get('clientId') }) });
        $('#key-result').html(`<p class="small text-body-secondary mb-1">Key (shown once — store it):</p><textarea class="form-control font-monospace" rows="2" readonly>${esc(r.key)}</textarea>`);
      } catch (err) { showErr(e.target, err.message); }
    });
    $('[data-revoke]').on('click', async function () {
      try { await api(`/api/integration/keys/${this.dataset.revoke}/revoke`, { method: 'POST' }); location.reload(); }
      catch (err) { showErr('.admin-main', err.message); }
    });
    $('#test-session').on('click', async () => {
      const vids = $('#test-vids').val().split(',').map(Number).filter(Boolean);
      const ttl = +$('#test-ttl').val() || 300;
      try {
        const r = await api('/api/integration/session', { method: 'POST', body: JSON.stringify({ vehicleIds: vids, ttlSeconds: ttl }) });
        $('#session-result').html(`<p class="small text-body-secondary mb-1">Expires ${new Date(r.expiresAt).toLocaleString()} — connect with:</p><textarea class="form-control font-monospace" rows="3" readonly>wss://${location.host}${r.wsUrl}</textarea>`);
      } catch (err) { $('#session-result').html(`<div class="alert alert-danger py-2">${esc(err.message)}</div>`); }
    });
  </script>
</body>
</html>
