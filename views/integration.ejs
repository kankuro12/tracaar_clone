<%- include('partials/head', { title: 'ERP integration' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <h1 class="h4 mb-4">ERP integration</h1>
      <div class="card mb-4">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-body-secondary">How it works</h2>
          <p class="small text-body-secondary mb-0">Create an API key for the ERP. The ERP calls
          <span class="font-monospace">POST /api/integration/register</span> with
          <span class="font-monospace">{ erpClientId, email, password }</span> (the dashboard
          admin's credentials) to obtain or rotate its key, then
          <span class="font-monospace">POST /api/integration/session</span> with
          <span class="font-monospace">{ erpClientId, apiKey, vehicleIds, sessionLengthSeconds }</span>
          and connects to the returned <span class="font-monospace">wsUrl</span> for live positions.</p>
        </div>
      </div>
      <div class="card mb-4" style="max-width: 560px">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-body-secondary">New API key</h2>
          <form id="create-key" class="row g-3">
            <div class="col-12"><label class="form-label">Name (e.g. "Odoo ERP")</label><input class="form-control" name="name" required></div>
            <div class="col-12"><label class="form-label">ERP client id (ERP's own id, e.g. "odoo-prod")</label><input class="form-control font-monospace" name="clientId" placeholder="required — used by the ERP to mint sessions" required></div>
            <div class="col-12"><button class="btn btn-dark" type="submit">Create key</button></div>
          </form>
          <div id="key-result" class="mt-3"></div>
        </div>
      </div>
      <div class="card mb-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Client ID</th><th>Created</th><th>Status</th><th class="text-end"></th></tr></thead>
            <tbody>
              <% if (!keys.length) { %><tr><td colspan="5" class="text-body-secondary">No keys yet.</td></tr><% } %>
              <% keys.forEach((k) => { %>
              <tr>
                <td class="fw-medium"><%= k.name %></td>
                <td class="font-monospace small"><%= k.client_id || '—' %></td>
                <td class="font-monospace small"><%= fmtDT(k.created_at) %></td>
                <td><%= k.revoked_at ? '<span class="badge text-bg-secondary">revoked</span>' : '<span class="badge text-bg-success">active</span>' %></td>
                <td class="text-end"><% if (!k.revoked_at) { %><button class="btn btn-sm btn-outline-danger" data-revoke="<%= k.id %>">Revoke</button><% } %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-body-secondary">Test session (current browser session)</h2>
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Vehicle ids (comma-separated)</label><input id="test-vids" class="form-control font-monospace" value="<%= vehicles.map((v) => v.id).join(',') %>"></div>
            <div class="col-md-3"><label class="form-label">TTL seconds</label><input id="test-ttl" class="form-control" type="number" value="300" min="30"></div>
            <div class="col-md-3 d-flex align-items-end"><button class="btn btn-dark w-100" id="test-session">Mint session token</button></div>
          </div>
          <div id="session-result" class="mt-3"></div>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    $('#create-key').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try {
        const r = await api('/api/integration/keys', { method: 'POST', body: JSON.stringify({ name: f.get('name'), clientId: f.get('clientId') }) });
        $('#key-result').html(`<p class="small text-body-secondary mb-1">Key (shown once — store it):</p><textarea class="form-control font-monospace" rows="2" readonly>${esc(r.key)}</textarea>`);
      } catch (err) { showErr(e.target, err.message); }
    });
    $('[data-revoke]').on('click', async function () {
      try { await api(`/api/integration/keys/${this.dataset.revoke}/revoke`, { method: 'POST' }); location.reload(); }
      catch (err) { showErr('.admin-main', err.message); }
    });
    $('#test-session').on('click', async () => {
      const vids = $('#test-vids').val().split(',').map(Number).filter(Boolean);
      const ttl = +$('#test-ttl').val() || 300;
      try {
        const r = await api('/api/integration/session', { method: 'POST', body: JSON.stringify({ vehicleIds: vids, ttlSeconds: ttl }) });
        $('#session-result').html(`<p class="small text-body-secondary mb-1">Expires ${new Date(r.expiresAt).toLocaleString()} — connect with:</p><textarea class="form-control font-monospace" rows="3" readonly>wss://${location.host}${r.wsUrl}</textarea>`);
      } catch (err) { $('#session-result').html(`<div class="alert alert-danger py-2">${esc(err.message)}</div>`); }
    });
  </script>
</body>
</html>
