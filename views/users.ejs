<%- include('partials/head', { title: 'Users' }) %>
  <%- include('partials/topbar') %>
  <div class="admin-layout">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main">
      <h1>Users</h1>
      <form class="card-form" id="create-user">
        <h2>New user</h2>
        <label>Name <input name="name" required></label>
        <label>Email <input name="email" type="email" required></label>
        <label>Password <input name="password" type="password" required></label>
        <button class="btn" type="submit">Create user</button>
        <div class="form-error" hidden></div>
      </form>
      <table class="tbl">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
        <tbody>
          <% users.forEach((u) => { %>
          <tr>
            <td><%= u.name %></td>
            <td class="mono"><%= u.email %></td>
            <td><%= u.role %></td>
            <td><button class="btn small" data-pw="<%= u.id %>" data-name="<%= u.name %>">Reset password</button></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
  <script>
    document.getElementById('create-user').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try {
        await api('/api/users', { method: 'POST', body: JSON.stringify(Object.fromEntries(f)) });
        location.reload();
      } catch (err) { showErr(e.target, err.message); }
    });
    document.querySelectorAll('[data-pw]').forEach((b) => b.addEventListener('click', async () => {
      const pw = prompt(`New password for ${b.dataset.name} (min 6 chars):`);
      if (!pw) return;
      try { await api(`/api/users/${b.dataset.pw}/password`, { method: 'PATCH', body: JSON.stringify({ password: pw }) }); location.reload(); }
      catch (err) { showErr(document.querySelector('.admin-main'), err.message); }
    }));
  </script>
</body>
</html>
