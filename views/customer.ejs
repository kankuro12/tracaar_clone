<%- include('partials/head', { title: customer.name }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active: 'customers' }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <a class="btn btn-sm btn-outline-secondary mb-3 d-inline-flex align-items-center gap-1" href="/admin/customers">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        All Customers
      </a>
      <h1 class="h4 mb-4 fw-bold"><%= customer.name %></h1>
      
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="card h-100">
            <div class="card-body p-4">
              <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">Vehicles</h2>
              <form id="reg-vehicle" class="row g-2 mb-4">
                <div class="col-6"><label class="form-label text-body-secondary small font-medium">Name</label><input class="form-control" name="name" required placeholder="Bus 1"></div>
                <div class="col-6"><label class="form-label text-body-secondary small font-medium">IMEI</label><input class="form-control font-monospace" name="imei" required placeholder="IMEI number"></div>
                <div class="col-6"><label class="form-label text-body-secondary small font-medium">Plate</label><input class="form-control" name="plate" placeholder="License plate"></div>
                <div class="col-12 mt-2"><button class="btn btn-primary bg-gradient btn-sm px-3 py-2 font-medium" type="submit">Assign IMEI / Register</button></div>
              </form>
              <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                  <thead><tr><th>ID</th><th>Name</th><th>IMEI</th><th>Plate</th><th>Last Report</th><th class="text-end"></th></tr></thead>
                  <tbody>
                    <% if (!vehicles.length) { %><tr><td colspan="6" class="text-body-secondary py-3 text-center">No vehicles yet — register an IMEI to start tracking.</td></tr><% } %>
                    <% vehicles.forEach((v) => { %>
                    <tr>
                      <td class="font-monospace small text-body-secondary"><%= v.id %></td>
                      <td class="fw-semibold"><%= v.name %></td>
                      <td class="font-monospace small"><%= v.imei %></td>
                      <td class="font-monospace small"><%= v.plate || '—' %></td>
                      <td class="font-monospace small text-body-secondary"><%= fmtDT(v.last_reported) %></td>
                      <td class="text-end"><button class="btn btn-sm btn-outline-danger" data-del-vehicle="<%= v.id %>">Delete</button></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="card h-100">
            <div class="card-body p-4">
              <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">Users</h2>
              <form id="create-tenant-user" class="row g-2 mb-4">
                <div class="col-6"><label class="form-label text-body-secondary small font-medium">Name</label><input class="form-control" name="name" required placeholder="User Name"></div>
                <div class="col-6"><label class="form-label text-body-secondary small font-medium">Email</label><input class="form-control" name="email" type="email" required placeholder="user@domain.com"></div>
                <div class="col-6"><label class="form-label text-body-secondary small font-medium">Password</label><input class="form-control" name="password" type="password" required placeholder="••••••••"></div>
                <div class="col-6">
                  <label class="form-label text-body-secondary small font-medium">Role</label>
                  <select class="form-select" name="role"><option value="user">user</option><option value="admin">admin</option></select>
                </div>
                <div class="col-12 mt-2"><button class="btn btn-primary bg-gradient btn-sm px-3 py-2 font-medium" type="submit">Create User</button></div>
              </form>
              <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                  <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th class="text-end"></th></tr></thead>
                  <tbody>
                    <% users.forEach((u) => { %>
                    <tr>
                      <td class="font-monospace small text-body-secondary"><%= u.id %></td>
                      <td class="fw-semibold"><%= u.name %></td>
                      <td class="font-monospace small text-body-secondary"><%= u.email %></td>
                      <td><span class="badge text-bg-dark border border-secondary-subtle font-monospace text-uppercase" style="font-size: 10px;"><%= u.role %></span></td>
                      <td class="text-end">
                        <div class="d-inline-flex gap-1">
                          <button class="btn btn-sm btn-outline-secondary" data-pw="<%= u.id %>" data-name="<%= u.name %>">Reset</button>
                          <button class="btn btn-sm btn-outline-danger" data-del-user="<%= u.id %>">Delete</button>
                        </div>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    const cid = '<%= customer.id %>';
    $('#reg-vehicle').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try { await api(`/api/customers/${cid}/vehicles`, { method: 'POST', body: JSON.stringify({ name: f.get('name'), imei: f.get('imei'), plate: f.get('plate') }) }); location.reload(); }
      catch (err) { showErr(e.target, err.message); }
    });
    $('#create-tenant-user').on('submit', async (e) => {
      e.preventDefault();
      const f = Object.fromEntries(new FormData(e.target).entries());
      try { await api(`/api/customers/${cid}/users`, { method: 'POST', body: JSON.stringify(f) }); location.reload(); }
      catch (err) { showErr(e.target, err.message); }
    });
    $('[data-del-vehicle]').on('click', async function () {
      if (!confirm('Delete this vehicle?')) return;
      try { await api(`/api/customers/${cid}/vehicles/${this.dataset.delVehicle}`, { method: 'DELETE' }); location.reload(); }
      catch (err) { showErr('.admin-main', err.message); }
    });
    $('[data-del-user]').on('click', async function () {
      if (!confirm('Delete this user?')) return;
      try { await api(`/api/customers/${cid}/users/${this.dataset.delUser}`, { method: 'DELETE' }); location.reload(); }
      catch (err) { showErr('.admin-main', err.message); }
    });
    $('[data-pw]').on('click', async function () {
      const pw = prompt(`New password for ${this.dataset.name} (min 6 chars):`);
      if (!pw) return;
      try { await api(`/api/customers/${cid}/users/${this.dataset.pw}/password`, { method: 'PATCH', body: JSON.stringify({ password: pw }) }); location.reload(); }
      catch (err) { showErr('.admin-main', err.message); }
    });
  </script>
</body>
</html>
