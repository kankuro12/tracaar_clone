<%# Ignition badge. `ignition` is true / false / null (device did not report it).
    null is shown distinctly rather than as "off" — an unreported state is not
    the same as a confirmed one. %>
<% if (ignition === null || ignition === undefined) { %>
<span class="badge text-bg-light border text-body-secondary" data-f="ignition" data-on="0" title="Device did not report ignition status">ign n/a</span>
<% } else if (ignition) { %>
<span class="badge text-bg-warning" data-f="ignition" data-on="1" title="Ignition on (ACC)">ignition on</span>
<% } else { %>
<span class="badge text-bg-secondary" data-f="ignition" data-on="0" title="Ignition off">ignition off</span>
<% } %>
