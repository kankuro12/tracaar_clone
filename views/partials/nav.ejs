<nav class="admin-nav d-flex flex-column gap-1 p-3 border-end border-dark-subtle bg-dark" style="width: 220px; min-height: calc(100vh - 56px); flex-shrink: 0; background: rgba(15, 22, 35, 0.75) !important;">
  <% (nav || []).forEach(([href, label]) => { %>
  <a class="admin-tab nav-link rounded-3 px-3 py-2 font-medium d-flex align-items-center justify-content-between transition-all <%= (href === '/admin/' + active || (active && href.indexOf(active) > -1)) ? 'active text-white bg-primary shadow-sm' : 'text-body-secondary hover-bg-dark' %>" href="<%= href %>">
    <span><%= label %></span>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><polyline points="9 18 15 12 9 6"/></svg>
  </a>
  <% }) %>
</nav>
