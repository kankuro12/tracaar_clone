<%- include('partials/head', { title: `${vehicle.name} — positions` }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active: 'vehicles' }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <a class="btn btn-sm btn-outline-dark mb-2" href="/admin/vehicles">← All vehicles</a>
      <h1 class="h4 mb-4"><%= vehicle.name %> — position history</h1>
      <%- include('partials/pager', { page, pages, total, baseUrl: `/admin/vehicles/${vehicle.id}/positions` }) %>
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>ID</th><th>Recorded</th><th>Device time</th><th>Valid</th><th>Lat</th><th>Lon</th><th>Speed (kn)</th><th>Course</th></tr></thead>
            <tbody>
              <% if (!positions.length) { %><tr><td colspan="8" class="text-body-secondary">No positions recorded yet.</td></tr><% } %>
              <% positions.forEach((p) => { %>
              <tr>
                <td class="font-monospace small"><%= p.id %></td>
                <td class="font-monospace small"><%= fmtDT(p.recorded_at) %></td>
                <td class="font-monospace small"><%= fmtDT(p.device_time) %></td>
                <td><%= p.valid ? 'yes' : 'no' %></td>
                <td class="font-monospace small"><%= p.lat.toFixed(6) %></td>
                <td class="font-monospace small"><%= p.lon.toFixed(6) %></td>
                <td class="font-monospace small"><%= p.speed_kn %></td>
                <td class="font-monospace small"><%= p.course %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="mt-3"><%- include('partials/pager', { page, pages, total, baseUrl: `/admin/vehicles/${vehicle.id}/positions` }) %></div>
    </main>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
