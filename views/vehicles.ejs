<%- include('partials/head', { title: 'Vehicles' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <h1 class="h4 mb-0 fw-bold">Vehicles</h1>
        <div class="d-flex gap-2"><input class="form-control form-control-sm table-search" data-table-filter=".table" placeholder="Search…"><span class="badge text-bg-secondary px-3 py-2 font-monospace"><%= vehicles.length %> Total</span></div>
      </div>

      <div class="card mb-4" style="max-width: 680px">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-3" style="font-size: 11px; letter-spacing: 0.05em;">Register vehicle</h2>
          <form id="create-vehicle" class="row g-3">
            <div class="col-md-4">
              <label class="form-label text-body-secondary small font-medium">Name</label>
              <input class="form-control" name="name" required placeholder="e.g. Bus 101">
            </div>
            <div class="col-md-4">
              <label class="form-label text-body-secondary small font-medium">IMEI</label>
              <input class="form-control font-monospace" name="imei" required placeholder="15 digits">
            </div>
            <div class="col-md-4">
              <label class="form-label text-body-secondary small font-medium">Plate</label>
              <input class="form-control" name="plate" placeholder="BA 1 PA 1234">
            </div>
            <div class="col-12 mt-3">
              <button class="btn btn-primary bg-gradient d-inline-flex align-items-center gap-2 px-4 py-2 font-medium" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Register Vehicle
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Plate</th>
                <th>IMEI</th>
                <th>Destination</th>
                <th>Assigned Users</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!vehicles.length) { %>
              <tr><td colspan="6" class="text-body-secondary py-4 text-center">No vehicles registered yet.</td></tr>
              <% } %>
              <% vehicles.forEach((v) => { %>
              <tr>
                <td class="fw-semibold text-white"><%= v.name %></td>
                <td><span class="badge text-bg-dark border border-secondary-subtle font-monospace"><%= v.plate || '—' %></span></td>
                <td class="font-monospace small text-body-secondary"><%= v.imei %></td>
                <td class="font-monospace small"><%= v.destination ? `${v.destination.lat.toFixed(5)}, ${v.destination.lon.toFixed(5)}` : '—' %></td>
                <td>
                  <form class="d-flex gap-1 assign-form align-items-center mb-1" data-vid="<%= v.id %>">
                    <select class="form-select form-select-sm assign-user" style="width: auto">
                      <% users.forEach((u) => { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
                    </select>
                    <button class="btn btn-sm btn-outline-light assign-add" type="submit">Assign</button>
                  </form>
                  <div class="assign-list">
                    <% (assignedMap[v.id] || []).forEach((n) => { %><span class="badge text-bg-dark border border-secondary-subtle font-sans"><%= n %></span><% }) %>
                  </div>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-2">
                    <a class="btn btn-sm btn-primary bg-gradient d-inline-flex align-items-center gap-1" href="/admin/vehicles/<%= v.id %>/live">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/></svg>
                      Live Map
                    </a>
                    <a class="btn btn-sm btn-outline-light d-inline-flex align-items-center gap-1" href="/admin/vehicles/<%= v.id %>/positions">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                      Positions
                    </a>
                    <button class="btn btn-sm btn-outline-light d-inline-flex align-items-center gap-1" data-dest="<%= v.id %>" data-name="<%= v.name %>">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                      Dest
                    </button>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="modal fade" id="dest-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content border border-secondary-subtle" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(16px); border-radius: 14px;">
            <form id="dest-form" class="p-4">
              <h2 class="h6 font-semibold text-white mb-3" id="dest-title"></h2>
              <div class="mb-3">
                <label class="form-label text-body-secondary small font-medium">Latitude</label>
                <input class="form-control font-monospace" name="lat" type="number" step="any" placeholder="27.7172">
              </div>
              <div class="mb-3">
                <label class="form-label text-body-secondary small font-medium">Longitude</label>
                <input class="form-control font-monospace" name="lon" type="number" step="any" placeholder="85.3240">
              </div>
              <div class="form-check mb-4">
                <input class="form-check-input" name="clear" type="checkbox" id="dest-clear">
                <label class="form-check-label small text-body-secondary" for="dest-clear">Clear destination</label>
              </div>
              <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-primary bg-gradient w-100 py-2 font-medium" type="submit">Save Destination</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    let destVid = null;
    $('#create-vehicle').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try { await api('/api/vehicles', { method: 'POST', body: JSON.stringify({ name: f.get('name'), imei: f.get('imei'), plate: f.get('plate') }) }); location.reload(); }
      catch (err) { showErr(e.target, err.message); }
    });
    $('.assign-form').on('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      try { await api(`/api/vehicles/${form.dataset.vid}/assign`, { method: 'POST', body: JSON.stringify({ userId: +$(form).find('.assign-user').val() }) }); location.reload(); }
      catch (err) { showErr(form, err.message); }
    });
    $('[data-dest]').on('click', function () {
      destVid = this.dataset.dest;
      $('#dest-title').text(`Destination for ${this.dataset.name}`);
      new bootstrap.Modal('#dest-modal').show();
    });
    $('#dest-form').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try {
        await api(`/api/vehicles/${destVid}/destination`, { method: 'PATCH', body: JSON.stringify({ lat: +f.get('lat'), lon: +f.get('lon'), clear: f.get('clear') === 'on' }) });
        location.reload();
      } catch (err) { showErr(e.target, err.message); }
    });
  </script>
</body>
</html>
