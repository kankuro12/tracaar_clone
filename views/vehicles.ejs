<%- include('partials/head', { title: 'Vehicles' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <h1 class="h4 mb-4">Vehicles</h1>
      <div class="card mb-4" style="max-width: 640px">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-body-secondary">Register vehicle</h2>
          <form id="create-vehicle" class="row g-3">
            <div class="col-md-4"><label class="form-label">Name</label><input class="form-control" name="name" required></div>
            <div class="col-md-4"><label class="form-label">IMEI</label><input class="form-control font-monospace" name="imei" required></div>
            <div class="col-md-4"><label class="form-label">Plate</label><input class="form-control" name="plate"></div>
            <div class="col-12"><button class="btn btn-dark" type="submit">Register</button></div>
          </form>
        </div>
      </div>
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Plate</th><th>IMEI</th><th>Destination</th><th>Assigned users</th><th class="text-end"></th></tr></thead>
            <tbody>
              <% if (!vehicles.length) { %><tr><td colspan="6" class="text-body-secondary">No vehicles yet.</td></tr><% } %>
              <% vehicles.forEach((v) => { %>
              <tr>
                <td class="fw-medium"><%= v.name %></td>
                <td><%= v.plate || '—' %></td>
                <td class="font-monospace small"><%= v.imei %></td>
                <td class="font-monospace small"><%= v.destination ? `${v.destination.lat.toFixed(5)}, ${v.destination.lon.toFixed(5)}` : '—' %></td>
                <td>
                  <form class="d-flex gap-1 assign-form" data-vid="<%= v.id %>">
                    <select class="form-select form-select-sm assign-user" style="width: auto">
                      <% users.forEach((u) => { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
                    </select>
                    <button class="btn btn-sm btn-outline-dark assign-add" type="submit">Assign</button>
                  </form>
                  <div class="assign-list">
                    <% (assignedMap[v.id] || []).forEach((n) => { %><span class="badge text-bg-light border"><%= n %></span><% }) %>
                  </div>
                </td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-dark" href="/admin/vehicles/<%= v.id %>/positions">Positions</a>
                  <button class="btn btn-sm btn-outline-dark" data-dest="<%= v.id %>" data-name="<%= v.name %>">Dest</button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="modal fade" id="dest-modal" tabindex="-1">
        <div class="modal-dialog modal-sm">
          <div class="modal-content">
            <form id="dest-form" class="p-3">
              <h2 class="h5 mb-3" id="dest-title"></h2>
              <div class="mb-3"><label class="form-label">Latitude</label><input class="form-control" name="lat" type="number" step="any"></div>
              <div class="mb-3"><label class="form-label">Longitude</label><input class="form-control" name="lon" type="number" step="any"></div>
              <div class="form-check mb-3"><input class="form-check-input" name="clear" type="checkbox" id="dest-clear"><label class="form-check-label" for="dest-clear">Clear destination</label></div>
              <button class="btn btn-dark" type="submit">Save</button>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    let destVid = null;
    $('#create-vehicle').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try { await api('/api/vehicles', { method: 'POST', body: JSON.stringify({ name: f.get('name'), imei: f.get('imei'), plate: f.get('plate') }) }); location.reload(); }
      catch (err) { showErr(e.target, err.message); }
    });
    $('.assign-form').on('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      try { await api(`/api/vehicles/${form.dataset.vid}/assign`, { method: 'POST', body: JSON.stringify({ userId: +$(form).find('.assign-user').val() }) }); location.reload(); }
      catch (err) { showErr(form, err.message); }
    });
    $('[data-dest]').on('click', function () {
      destVid = this.dataset.dest;
      $('#dest-title').text(`Destination for ${this.dataset.name}`);
      new bootstrap.Modal('#dest-modal').show();
    });
    $('#dest-form').on('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      try {
        await api(`/api/vehicles/${destVid}/destination`, { method: 'PATCH', body: JSON.stringify({ lat: +f.get('lat'), lon: +f.get('lon'), clear: f.get('clear') === 'on' }) });
        location.reload();
      } catch (err) { showErr(e.target, err.message); }
    });
  </script>
</body>
</html>
