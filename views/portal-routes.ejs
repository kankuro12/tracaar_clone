<%- include('partials/head', { title: 'Saved routes' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <h1 class="h4 mb-0 fw-bold">Saved routes</h1>
        <span class="badge text-bg-secondary px-3 py-2 font-monospace"><%= routes.length %> private</span>
      </div>
      <p class="small text-body-secondary mb-4">Routes are private to your login. Add a route here, capture a vehicle’s current GPS fix from any live map, then load the saved stops later.</p>

      <div class="row g-3">
        <div class="col-12 col-lg-5">
          <div class="card mb-3">
            <div class="card-body p-3">
              <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.05em;">New route</h2>
              <label class="form-label small" for="route-name">Route name</label>
              <input id="route-name" class="form-control mb-2" maxlength="80" placeholder="Morning school run">
              <label class="form-label small" for="route-points">Stops, one per line <span class="text-body-secondary">(lat, lon, optional label)</span></label>
              <textarea id="route-points" rows="4" class="form-control font-monospace mb-2" placeholder="27.7172, 85.3240, Depot&#10;27.7200, 85.3300"></textarea>
              <button class="btn btn-primary w-100" id="route-create">Save route</button>
            </div>
          </div>

          <div class="card">
            <div class="card-body p-3">
              <h2 class="h6 text-uppercase text-body-secondary font-monospace fw-bold mb-2" style="font-size: 11px; letter-spacing: 0.05em;">My routes</h2>
              <% if (!routes.length) { %>
                <p class="small text-body-secondary mb-0">No saved routes yet. Create one above.</p>
              <% } %>
              <div class="list-group list-group-flush" id="route-list">
                <% routes.forEach((r) => { %>
                  <div class="list-group-item px-0 d-flex align-items-center justify-content-between gap-2" data-route-id="<%= r.id %>">
                    <div class="min-w-0">
                      <div class="fw-semibold text-truncate"><%= r.name %></div>
                      <div class="small text-body-secondary font-monospace"><%= Array.isArray(r.points) ? r.points.length : 0 %> stops · updated <%= fmtDT(r.updated_at) %></div>
                    </div>
                    <div class="d-flex gap-1 flex-shrink-0">
                      <button class="btn btn-sm btn-outline-primary route-load">Load</button>
                      <button class="btn btn-sm btn-outline-secondary route-optimize">Optimize</button>
                      <button class="btn btn-sm btn-outline-danger route-delete">Delete</button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-7">
          <div class="card overflow-hidden">
            <div id="saved-route-map" style="height: 60vh; min-height: 360px;"></div>
            <div class="card-footer d-flex align-items-center justify-content-between gap-2 flex-wrap">
              <span id="route-status" class="small text-body-secondary">Pick Load to preview a route.</span>
              <button id="route-clear" class="btn btn-sm btn-outline-secondary">Clear map</button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <%- include('partials/map-lib') %>
  <script src="/saved-routes.js"></script>
  <script>
    const map = L.map('saved-route-map').setView([27.7, 85.3], 12);
    baseLayer(map);
    let currentRouteId = null;
    let routeLayer = { line: null, stops: [] };

    function setStatus(msg) { $('#route-status').text(msg); }

    $('#route-create').on('click', async function () {
      try {
        const name = $('#route-name').val();
        const route = await SavedRoutes.create(name, SavedRoutes.parseText($('#route-points').val()));
        currentRouteId = route.id;
        location.reload();
      } catch (err) { showErr(this.closest('.card-body'), err.message); }
    });

    $('#route-list').on('click', '.route-load', async function () {
      try {
        currentRouteId = $(this).closest('[data-route-id]').data('route-id');
        const route = await SavedRoutes.get(currentRouteId);
        routeLayer = SavedRoutes.clearLayer(routeLayer);
        routeLayer = SavedRoutes.draw(map, route.points, { fit: true });
        setStatus(`${route.name}: ${route.points.length} stops loaded.`);
      } catch (err) { showErr(this.closest('.card-body') || '.admin-main', err.message); }
    });

    $('#route-list').on('click', '.route-delete', async function () {
      const row = $(this).closest('[data-route-id]');
      if (!confirm('Delete this saved route?')) return;
      try { await SavedRoutes.remove(row.data('route-id')); location.reload(); }
      catch (err) { showErr(row, err.message); }
    });

    $('#route-list').on('click', '.route-optimize', async function () {
      try {
        currentRouteId = $(this).closest('[data-route-id]').data('route-id');
        const route = await SavedRoutes.get(currentRouteId);
        if (route.points.length < 2) { setStatus('Needs at least two stops to optimize.'); return; }
        const r = await api('/api/routes/optimize', {
          method: 'POST',
          body: JSON.stringify({ waypoints: route.points.map((p) => [p.lat, p.lon]) }),
        });
        const ordered = r.order.map((i) => route.points[i]);
        const saved = await SavedRoutes.save(currentRouteId, ordered);
        routeLayer = SavedRoutes.clearLayer(routeLayer);
        routeLayer = SavedRoutes.draw(map, saved.points, { fit: true });
        setStatus(`${saved.name}: optimized to ${r.totalKm} km, saved.`);
      } catch (err) { showErr(this.closest('.card-body') || '.admin-main', err.message); }
    });

    $('#route-clear').on('click', () => {
      routeLayer = SavedRoutes.clearLayer(routeLayer);
      setStatus('Map cleared.');
    });
  </script>
</body>
</html>
