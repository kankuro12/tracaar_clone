<%- include('partials/head', { title: 'Sign in' }) %>
<body class="bg-body-tertiary">
  <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh">
    <div class="card shadow-sm" style="width: 360px">
      <div class="card-body p-4">
        <h1 class="h3 fw-bold text-center mb-1">FLEET</h1>
        <p class="text-body-secondary text-center small mb-4">Live GPS tracking console</p>
        <form action="/login" method="post">
          <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <input class="form-control" id="email" name="email" type="email" autocomplete="username" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
          </div>
          <button type="submit" class="btn btn-dark w-100">Sign in</button>
          <% if (error) { %><div class="alert alert-danger mt-3 mb-0"><%= error %></div><% } %>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
