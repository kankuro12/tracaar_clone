<%- include('partials/head', { title: 'Customers' }) %>
  <%- include('partials/topbar') %>
  <div class="d-flex">
    <%- include('partials/nav', { active }) %>
    <main class="admin-main flex-grow-1 p-4 bg-body-tertiary" style="min-height: calc(100vh - 56px)">
      <h1 class="h4 mb-4">Customers</h1>
      <div class="card mb-4">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-body-secondary">New customer</h2>
          <form id="create-customer" class="row g-3">
            <div class="col-md-4"><label class="form-label">Company</label><input class="form-control" name="name" required></div>
            <div class="col-md-4"><label class="form-label">Admin name</label><input class="form-control" name="adminName" required></div>
            <div class="col-md-4"><label class="form-label">Admin email</label><input class="form-control" name="adminEmail" type="email" required></div>
            <div class="col-md-4"><label class="form-label">Admin password</label><input class="form-control" name="adminPassword" type="password" required></div>
            <div class="col-md-4">
              <label class="form-label">Plan</label>
              <select class="form-select" name="planId"><% plans.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %> — <%= money(p.price_monthly) %></option><% }) %></select>
            </div>
            <div class="col-12"><button class="btn btn-dark" type="submit">Create customer</button></div>
          </form>
        </div>
      </div>
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Plan</th><th>Vehicles</th><th>Users</th><th>Alert email</th><th class="text-end"></th></tr></thead>
            <tbody>
              <% if (!customers.length) { %><tr><td colspan="6" class="text-body-secondary">No customers yet.</td></tr><% } %>
              <% customers.forEach((c) => { %>
              <tr>
                <td class="fw-medium"><%= c.name %></td>
                <td><%= c.plan || '—' %></td>
                <td><%= c.vehicle_count %></td>
                <td><%= c.user_count %></td>
                <td class="font-monospace small"><%= c.alert_email || '—' %></td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-dark" href="/admin/customers/<%= c.id %>">Manage</a>
                  <button class="btn btn-sm btn-outline-dark" data-edit='<%= JSON.stringify({ id: c.id, name: c.name, plan_id: c.plan_id, alert_email: c.alert_email, alert_webhook: c.alert_webhook }) %>'>Edit</button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="modal fade" id="edit-modal" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <form id="edit-customer" class="p-3">
              <h2 class="h5 mb-3" id="edit-title"></h2>
              <div class="mb-3">
                <label class="form-label">Plan</label>
                <select class="form-select" name="planId"><% plans.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select>
              </div>
              <div class="mb-3"><label class="form-label">Alert email</label><input class="form-control" name="alertEmail" type="email"></div>
              <div class="mb-3"><label class="form-label">Alert webhook</label><input class="form-control" name="alertWebhook"></div>
              <button class="btn btn-dark" type="submit">Save</button>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
  <%- include('partials/scripts') %>
  <script>
    $('#create-customer').on('submit', async (e) => {
      e.preventDefault();
      const f = Object.fromEntries(new FormData(e.target).entries());
      try { await api('/api/customers', { method: 'POST', body: JSON.stringify(f) }); location.reload(); }
      catch (err) { showErr(e.target, err.message); }
    });
    $('[data-edit]').on('click', function () {
      const c = JSON.parse(this.dataset.edit);
      $('#edit-title').text(c.name);
      const form = $('#edit-customer')[0];
      form.planId.selectedIndex = -1;
      if (c.plan_id) form.planId.value = c.plan_id;
      form.alertEmail.value = c.alert_email || '';
      form.alertWebhook.value = c.alert_webhook || '';
      $('#edit-customer').off('submit').on('submit', async (ev) => {
        ev.preventDefault();
        const f = new FormData(form);
        try {
          await api('/api/customers/' + c.id, { method: 'PATCH', body: JSON.stringify({ planId: f.get('planId') ? +f.get('planId') : null, alertEmail: f.get('alertEmail') || null, alertWebhook: f.get('alertWebhook') || null }) });
          location.reload();
        } catch (err) { showErr(form, err.message); }
      });
      new bootstrap.Modal('#edit-modal').show();
    });
  </script>
</body>
</html>
