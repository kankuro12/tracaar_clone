PORT=3000
INGEST_PORT=9000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleet
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-too-in-production
# seed defaults
SUPER_ADMIN_EMAIL=super@fleet.test
SUPER_ADMIN_PASSWORD=super123

# operational tuning (all optional)
# NODE_ENV=production            # marks the session cookie Secure (requires HTTPS)
# TRUST_PROXY=1                  # REQUIRED behind nginx/Caddy, else all clients share one rate-limit budget
# INGEST_LOG_FRAMES=1            # log every raw ingest frame (noisy — debugging only)
# POSITION_RETENTION_DAYS=180    # prune raw positions older than N days (rolled up into position_daily_summary first). unset = keep forever
# INGEST_ALLOWED_IPS=1.2.3.4,5.6.7.8  # comma list; if set, only these IPs may open the TCP ingest port
# SMTP_HOST=, SMTP_PORT=, SMTP_USER=, SMTP_PASS=, SMTP_SECURE=, SMTP_FROM=  # alert emails
# OFFLINE_AFTER_MIN=5             # minutes without a fix before a vehicle is flagged offline

# base map provider
MAP_TYPE=leaflet                 # leaflet = OpenStreetMap tiles (default, no key) | google = Google Map Tiles API
# GOOGLE_MAPS_API_KEY=           # REQUIRED when MAP_TYPE=google (restrict it by HTTP referrer - it reaches the browser)
# GOOGLE_MAPS_REFERRER=https://your.domain/   # REQUIRED if the key is HTTP-referrer restricted:
#                                             # the server's createSession call sends no Referer of its own
# GOOGLE_MAPS_MAP_TYPE=roadmap   # roadmap | satellite | terrain
# GOOGLE_MAPS_LANGUAGE=en-US
# GOOGLE_MAPS_REGION=NP     # CLDR region code; defaults to NP (Nepal)
